# --- Required ---------------------------------------------------------------
# 32+ random characters. Signs sessions; also derives the encryption key if ENCRYPTION_KEY is unset.
AUTH_SECRET=
# Public URL of the app, used in PR comments and webhook URLs (no trailing slash).
APP_URL=http://127.0.0.1:3000

# --- Database ---------------------------------------------------------------
# Neon Postgres. Leave empty to use embedded PGlite in ./data (local only).
DATABASE_URL=
# Encrypts stored model keys and webhook secrets (AES-256-GCM).
ENCRYPTION_KEY=

# --- Sign in with GitHub (OAuth app) -----------------------------------------
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- GitHub App ---------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM; "\n" escapes are accepted.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Model (OpenAI-compatible) -------------------------------------------------
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3-contributor
# Optional: Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# --- Runtime -----------------------------------------------------------------
# docker (local default) | sandbox (default on Vercel)
AFTERSHOCK_RUNNER=
# inline (local default) | durable (default on Vercel)
AFTERSHOCK_WORKFLOWS=
# Protects /api/cron/nightly (Vercel Cron sends it automatically).
CRON_SECRET=
# 1 = show “Try the demo workspace” on the sign-in page and seed demo data.
AFTERSHOCK_DEMO=1
