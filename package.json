{
  "name": "aftershock",
  "version": "0.2.1",
  "description": "Every incident becomes a regression test that git history proves, then guards every pull request.",
  "license": "Apache-2.0",
  "homepage": "https://aftershock-mk.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaanavKrishna/Aftershock.git"
  },
  "bugs": {
    "url": "https://github.com/MaanavKrishna/Aftershock/issues"
  },
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate.mts",
    "build:cli": "esbuild cli/aftershock.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/aftershock.mjs --alias:@=. --banner:js='#!/usr/bin/env node'",
    "vercel-build": "node scripts/vercel-build.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run build:cli && npm audit --omit=dev --audit-level=high",
    "build:action": "esbuild cli/aftershock.ts --bundle --platform=node --format=esm --target=node20 --outfile=action/dist/aftershock.mjs --alias:@=. --banner:js='#!/usr/bin/env node' --log-level=warning"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@neondatabase/serverless": "^1.2.0",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/sandbox": "^3.9.0",
    "diff": "^8.0.4",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.8.2",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "marked": "18.1.1",
    "motion": "14.6.0",
    "next": "^16.4.2",
    "openai": "^7.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "workflow": "^5.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "bin": {
    "aftershock": "./dist/aftershock.mjs"
  },
  "overrides": {
    "devalue": "^5.9.4",
    "source-map-js": "^1.2.2",
    "@workflow/core": {
      "nanoid": "^5.1.16"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "zod": "$zod",
    "undici@^6": "^6.29.1",
    "undici@^7": "^7.30.1"
  },
  "type": "module"
}
