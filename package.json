    "drizzle-orm": "^0.45.3",
    "geist": "^1.7.2",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "openai": "^7.30.0",
    "react": "^19.3.0",
