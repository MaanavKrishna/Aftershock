{
  "name": "aftershock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate.mts",
    "build:cli": "esbuild cli/aftershock.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/aftershock.mjs --alias:@=. --banner:js='#!/usr/bin/env node'",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.2.0",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "@vercel/blob": "^2.8.1",
    "@vercel/sandbox": "^3.5.1",
    "diff": "^8.0.4",
    "drizzle-orm": "^0.45.3",
    "geist": "^1.7.2",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "openai": "^7.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "workflow": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "bin": {
    "aftershock": "./dist/aftershock.mjs"
  },
  "overrides": {
    "devalue": "^5.9.4",
    "source-map-js": "^1.2.2",
    "@workflow/core": {
      "nanoid": "^5.1.16"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "type": "module"
}
